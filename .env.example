# Copy to .env for local dev (`npm run dev`). On Vercel, set these under
# Project Settings → Environment Variables instead.

# Opens the /bugs/ dashboard (list + triage bug reports).
BUG_KEY=

# Lets an editor Publish its menu for every device. Keep it different from BUG_KEY.
PUBLISH_KEY=

# Postgres: published menus (every version, kept forever), photo records and bug reports.
# On Vercel, the Neon integration sets it. Locally, point it at your own Postgres, for example
#   DATABASE_URL=postgres://postgres:<password>@localhost:5432/chucky
# then run `npm run db:migrate`. Leave it empty to use the file store in .data/ instead.
DATABASE_URL=

# Vercel Blob: where drink photo bytes are stored. Set by Vercel's Blob integration. Without it
# (local dev) the bytes are kept in Postgres. BLOB_ACCESS=private if the Blob store is private.
BLOB_READ_WRITE_TOKEN=
BLOB_ACCESS=

# The old Upstash Redis store. Only needed once, by `npm run db:import-upstash`, which copies the
# published menus, photos and bug reports it holds into Postgres.
KV_REST_API_URL=
KV_REST_API_TOKEN=
